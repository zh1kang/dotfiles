set nocompatible

syntax on

set tabstop=8
set softtabstop=0
set shiftwidth=4 smarttab
set expandtab

set shortmess+=I

set number

set laststatus=2

set encoding=UTF-8

set backspace=indent,eol,start
set ignorecase
set smartcase
set incsearch

nnoremap J 3j
nnoremap K 3k
vnoremap J 3j
vnoremap K 3k
